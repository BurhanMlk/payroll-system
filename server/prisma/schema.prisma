// ============================================================================
// EduPayroll SaaS — Prisma Schema
// Multi-tenant payroll platform for educational institutions.
// Every tenant-owned record carries a tenantId; uniqueness is scoped per tenant.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum TenantStatus {
  ACTIVE
  TRIALING
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  ACADEMY
  TRAINING_INSTITUTE
  OTHER
}

enum RoleScope {
  PLATFORM
  TENANT
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentProviderType {
  MANUAL
  STRIPE
  PADDLE
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  VISITING
  TEMPORARY
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
  RETIRED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  PAID_LEAVE
  UNPAID_LEAVE
  HOLIDAY
  WEEKEND
  WORK_FROM_HOME
}

enum AttendanceSource {
  MANUAL
  CSV
  API
  BIOMETRIC
}

enum BiometricDeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  DISABLED
}

enum BiometricPunchType {
  IN
  OUT
  BREAK_IN
  BREAK_OUT
  UNKNOWN
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  CUSTOM
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ComponentType {
  EARNING
  DEDUCTION
}

enum ComponentCalculation {
  FIXED
  PERCENTAGE
  FORMULA
}

enum ComponentFrequency {
  RECURRING
  ONE_TIME
}

enum PayrollCycleType {
  MONTHLY
  BI_WEEKLY
  WEEKLY
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  PENDING_REVIEW
  APPROVED
  PROCESSING
  PAID
  CANCELLED
  LOCKED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  ACTIVE
  DEDUCTED
  CANCELLED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum WorkingDaysMethod {
  FIXED_DAYS
  ACTUAL_DAYS
}

enum DocumentCategory {
  CONTRACT
  CNIC
  DEGREE
  CERTIFICATE
  OTHER
}

// ============================================================================
// CORE PLATFORM MODELS
// ============================================================================

model Tenant {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  institutionType InstitutionType @default(COLLEGE)
  status          TenantStatus    @default(TRIALING)
  phone           String?
  email           String?
  website         String?
  address         String?
  country         String?
  city            String?
  logoUrl         String?
  currency        String          @default("USD")
  timezone        String          @default("UTC")
  storageLimitMb  Int             @default(1024)
  suspendedReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  branches        Branch[]
  departments     Department[]
  designations    Designation[]
  employees       Employee[]
  users           User[]
  roles           Role[]
  subscription    Subscription?
  settings        TenantSetting[]
  payrollCycles   PayrollCycle[]
  salaryTemplates SalaryTemplate[]
  leaveTypes      LeaveType[]
  holidays        Holiday[]
  shifts          Shift[]
  attendance      Attendance[]
  payrollRuns     PayrollRun[]
  loans           EmployeeLoan[]
  advances        SalaryAdvance[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  invoices        Invoice[]

  biometricDevices  BiometricDevice[]
  biometricMappings BiometricEmployeeMap[]
  biometricPunches  BiometricPunch[]

  students           Student[]
  studentAttendances StudentAttendance[]
  studentFees        StudentFee[]

  @@index([status])
  @@index([createdAt])
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model User {
  id                  String     @id @default(cuid())
  tenantId            String?
  tenant              Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String     @unique
  fullName            String
  passwordHash        String
  phone               String?
  avatarUrl           String?
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  branchIds           Json? // tenant users: branch access scope (null = all branches)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  roles              UserRole[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  employee           Employee?
  approvedLeaves     LeaveRequest[]           @relation("LeaveApprover")
  approvedPayrolls   PayrollApproval[]
  managedBranches    Branch[]                 @relation("BranchManager")
  managedDepartments Department[]             @relation("DepartmentManager")

  @@index([tenantId])
  @@index([tenantId, status])
}

// ============================================================================
// ORGANIZATIONAL MODELS
// ============================================================================

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  phone     String?
  email     String?
  headName  String? // Head of Branch
  headCnic  String? // Head of Branch CNIC
  managerId String?
  manager   User?    @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees        Employee[]
  holidays         Holiday[]
  biometricDevices BiometricDevice[]
  students         Student[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  managerId String?
  manager   User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Designation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  grade     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Employee {
  id             String  @id @default(cuid())
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeNumber String
  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal
  firstName        String
  lastName         String
  fatherName       String?
  nationalId       String?
  dateOfBirth      DateTime?
  gender           Gender?
  photoUrl         String?
  phone            String?
  alternatePhone   String?
  email            String?
  address          String?
  emergencyContact String?

  // Employment
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId    String?
  designation      Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  employmentType   EmploymentType @default(PERMANENT)
  status           EmployeeStatus @default(ACTIVE)
  joiningDate      DateTime?
  confirmationDate DateTime?
  contractStart    DateTime?
  contractEnd      DateTime?

  // Banking
  bankName       String?
  accountTitle   String?
  accountNumber  String?
  bankBranchName String?

  // Payroll defaults
  basicSalary   Decimal @default(0) @db.Decimal(12, 2)
  salaryType    String  @default("MONTHLY")
  paymentMethod String  @default("BANK_TRANSFER")
  taxConfig     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents         EmployeeDocument[]
  salaryStructures  EmployeeSalaryStructure[]
  attendance        Attendance[]
  shifts            EmployeeShift[]
  biometricMappings BiometricEmployeeMap[]
  biometricPunches  BiometricPunch[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  payrollItems      PayrollItem[]
  payslips          Payslip[]
  loans             EmployeeLoan[]
  advances          SalaryAdvance[]
  overtime          Overtime[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, departmentId])
  @@index([tenantId, firstName, lastName])
}

model EmployeeDocument {
  id           String           @id @default(cuid())
  tenantId     String
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     DocumentCategory
  title        String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime         @default(now())

  @@index([tenantId, employeeId])
}

// ============================================================================
// RBAC MODELS
// ============================================================================

model Role {
  id          String    @id @default(cuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope       RoleScope @default(TENANT)
  name        String
  key         String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. employee.create
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ============================================================================
// SUBSCRIPTION & BILLING MODELS
// ============================================================================

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  key            String   @unique // starter | professional | enterprise
  description    String?
  monthlyPrice   Decimal  @db.Decimal(12, 2)
  yearlyPrice    Decimal  @db.Decimal(12, 2)
  currency       String   @default("USD")
  employeeLimit  Int      @default(50)
  branchLimit    Int      @default(1)
  userLimit      Int      @default(5)
  storageLimitMb Int      @default(1024)
  trialDays      Int      @default(7)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]

  @@index([isActive])
}

model PlanFeature {
  id         String           @id @default(cuid())
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  key        String // payroll.reports | attendance | loan_management | api_access ...
  label      String
  enabled    Boolean          @default(true)
  limitValue Int? // optional numeric cap
  createdAt  DateTime         @default(now())

  @@unique([planId, key])
  @@index([planId])
}

model Subscription {
  id                     String              @id @default(cuid())
  tenantId               String              @unique
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   SubscriptionPlan    @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus  @default(TRIALING)
  billingPeriod          BillingPeriod       @default(MONTHLY)
  startDate              DateTime            @default(now())
  trialEndDate           DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  renewalDate            DateTime
  gracePeriodEnd         DateTime?
  amount                 Decimal             @db.Decimal(12, 2)
  currency               String              @default("USD")
  autoRenew              Boolean             @default(true)
  paymentProvider        PaymentProviderType @default(MANUAL)
  providerSubscriptionId String?
  cancelAtPeriodEnd      Boolean             @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  payments SubscriptionPayment[]
  invoices Invoice[]

  @@index([status])
  @@index([renewalDate])
  @@index([tenantId, status])
}

model SubscriptionPayment {
  id             String              @id @default(cuid())
  tenantId       String
  subscriptionId String
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @default("USD")
  status         PaymentStatus       @default(PENDING)
  provider       PaymentProviderType @default(MANUAL)
  providerRef    String?
  billingPeriod  BillingPeriod       @default(MONTHLY)
  periodStart    DateTime
  periodEnd      DateTime
  invoiceId      String?
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paidAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber  String        @unique
  amount         Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  lineItems      Json?

  payments SubscriptionPayment[]

  @@index([tenantId])
  @@index([status])
}

model SubscriptionReminder {
  id             String   @id @default(cuid())
  tenantId       String
  subscriptionId String
  daysBefore     Int // 14 | 7 | 3 | 1 | 0 (0 = expiry day)
  type           String // EXPIRING | EXPIRED | PAYMENT_FAILED
  sentAt         DateTime @default(now())

  @@unique([subscriptionId, type, daysBefore])
  @@index([tenantId])
}

// ============================================================================
// ATTENDANCE, SHIFTS, HOLIDAYS
// ============================================================================

model Shift {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  type          ShiftType @default(CUSTOM)
  startTime     String // "08:00"
  endTime       String // "16:00"
  graceMinutes  Int       @default(15)
  breakMinutes  Int       @default(60)
  minHours      Decimal   @default(8) @db.Decimal(4, 2)
  overtimeAfter Decimal   @default(8) @db.Decimal(4, 2)
  lateRule      Json?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employees EmployeeShift[]

  @@index([tenantId])
}

model EmployeeShift {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId       String
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, employeeId])
  @@index([shiftId])
}

model Holiday {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime
  branchId    String? // null = tenant-wide holiday
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, date])
  @@index([tenantId, branchId])
}

model Attendance {
  id                    String           @id @default(cuid())
  tenantId              String
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                  DateTime
  checkIn               DateTime?
  checkOut              DateTime?
  workHours             Decimal?         @db.Decimal(5, 2)
  overtimeHours         Decimal          @default(0) @db.Decimal(5, 2)
  lateMinutes           Int              @default(0)
  earlyDepartureMinutes Int              @default(0)
  status                AttendanceStatus @default(PRESENT)
  source                AttendanceSource @default(MANUAL)
  shiftId               String?
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([tenantId, employeeId, date])
  @@index([tenantId, status])
}

// ============================================================================
// BIOMETRIC ATTENDANCE MODELS
// ============================================================================

model BiometricDevice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name         String
  code         String
  serialNumber String?
  manufacturer String?
  model        String?

  ipAddress String?
  port      Int?
  timezone  String?

  status BiometricDeviceStatus @default(ACTIVE)

  apiKeyHash String?

  lastSeenAt DateTime?
  lastSyncAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeMappings BiometricEmployeeMap[]
  punches          BiometricPunch[]

  @@unique([tenantId, code])
  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
}

model BiometricEmployeeMap {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deviceId String
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  biometricUserId String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, deviceId, biometricUserId])
  @@unique([tenantId, deviceId, employeeId])
  @@index([tenantId, employeeId])
  @@index([tenantId, deviceId])
}

model BiometricPunch {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deviceId String
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  biometricUserId String

  punchedAt DateTime
  punchType BiometricPunchType @default(UNKNOWN)

  externalPunchId String?

  processed   Boolean   @default(false)
  processedAt DateTime?

  rawPayload Json?
  createdAt  DateTime @default(now())

  @@unique([tenantId, deviceId, biometricUserId, punchedAt])
  @@index([tenantId, deviceId, punchedAt])
  @@index([tenantId, employeeId, punchedAt])
  @@index([tenantId, processed])
}

// ============================================================================
// LEAVE MODELS
// ============================================================================

model LeaveType {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  code             String
  annualQuota      Int      @default(0)
  isPaid           Boolean  @default(true)
  carryForward     Boolean  @default(false)
  maxCarryForward  Int      @default(0)
  approvalRequired Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model LeaveRequest {
  id              String      @id @default(cuid())
  tenantId        String
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime
  endDate         DateTime
  days            Decimal     @db.Decimal(5, 2)
  reason          String?
  status          LeaveStatus @default(PENDING)
  approverId      String?
  approver        User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  rejectionReason String?
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@index([tenantId, leaveTypeId])
}

model LeaveBalance {
  id             String    @id @default(cuid())
  tenantId       String
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year           Int
  totalQuota     Decimal   @default(0) @db.Decimal(5, 2)
  usedDays       Decimal   @default(0) @db.Decimal(5, 2)
  carriedForward Decimal   @default(0) @db.Decimal(5, 2)
  remaining      Decimal   @default(0) @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId])
}

// ============================================================================
// SALARY STRUCTURE MODELS
// ============================================================================

model SalaryTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  components       SalaryComponent[]
  salaryStructures EmployeeSalaryStructure[]

  @@index([tenantId])
}

model SalaryComponent {
  id          String               @id @default(cuid())
  tenantId    String
  templateId  String
  template    SalaryTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  type        ComponentType
  calculation ComponentCalculation @default(FIXED)
  value       Decimal              @default(0) @db.Decimal(12, 2) // fixed amount OR percentage
  formula     String? // formula expression when calculation = FORMULA
  frequency   ComponentFrequency   @default(RECURRING)
  taxable     Boolean              @default(false)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())

  @@index([tenantId, templateId])
}

model EmployeeSalaryStructure {
  id            String          @id @default(cuid())
  tenantId      String
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId    String?
  template      SalaryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  basicSalary   Decimal         @default(0) @db.Decimal(12, 2)
  components    Json // snapshot of salary components [{name,type,calculation,value,formula,taxable}]
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, employeeId, isActive])
}

// ============================================================================
// PAYROLL MODELS
// ============================================================================

model PayrollCycle {
  id                       String            @id @default(cuid())
  tenantId                 String
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                     String
  type                     PayrollCycleType  @default(MONTHLY)
  payDay                   Int               @default(1) // day of month salary is paid
  autoGenerateDay          Int? // day payroll draft auto-generates
  workingDaysMethod        WorkingDaysMethod @default(ACTUAL_DAYS)
  workingDaysPerMonth      Int               @default(22)
  overtimeEnabled          Boolean           @default(false)
  overtimeRate             Decimal           @default(1.5) @db.Decimal(4, 2)
  weekendOvertimeRate      Decimal           @default(2) @db.Decimal(4, 2)
  holidayOvertimeRate      Decimal           @default(2) @db.Decimal(4, 2)
  maxOvertimeHours         Int               @default(0)
  overtimeApprovalRequired Boolean           @default(true)
  approvalFlow             Json // single / multi level configuration
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  payrollRuns PayrollRun[]

  @@index([tenantId])
}

model PayrollRun {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId         String?
  cycle           PayrollCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  name            String // e.g. "October 2026 Payroll"
  periodStart     DateTime
  periodEnd       DateTime
  payDate         DateTime
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(14, 2)
  totalNet        Decimal       @default(0) @db.Decimal(14, 2)
  employeeCount   Int           @default(0)
  lockedAt        DateTime?
  lockedById      String?
  unlockReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items      PayrollItem[]
  approvals  PayrollApproval[]
  payslips   Payslip[]
  exceptions Json? // validation exceptions captured at generation time

  @@unique([tenantId, periodStart, periodEnd, name])
  @@index([tenantId, status])
  @@index([tenantId, periodStart, periodEnd])
}

model PayrollItem {
  id               String     @id @default(cuid())
  tenantId         String
  payrollRunId     String
  payrollRun       PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary      Decimal    @default(0) @db.Decimal(12, 2)
  grossSalary      Decimal    @default(0) @db.Decimal(12, 2)
  totalEarnings    Decimal    @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal    @default(0) @db.Decimal(12, 2)
  netSalary        Decimal    @default(0) @db.Decimal(12, 2)
  presentDays      Decimal    @default(0) @db.Decimal(5, 2)
  absentDays       Decimal    @default(0) @db.Decimal(5, 2)
  lateMinutes      Int        @default(0)
  overtimeHours    Decimal    @default(0) @db.Decimal(5, 2)
  paidLeaveDays    Decimal    @default(0) @db.Decimal(5, 2)
  unpaidLeaveDays  Decimal    @default(0) @db.Decimal(5, 2)
  loanDeduction    Decimal    @default(0) @db.Decimal(12, 2)
  advanceDeduction Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal    @default(0) @db.Decimal(12, 2)
  snapshot         Json // full snapshot of salary structure at time of calc
  createdAt        DateTime   @default(now())

  earnings   PayrollEarning[]
  deductions PayrollDeduction[]
  payslip    Payslip?

  @@unique([payrollRunId, employeeId])
  @@index([tenantId, payrollRunId])
  @@index([tenantId, employeeId])
}

model PayrollEarning {
  id            String        @id @default(cuid())
  tenantId      String
  payrollItemId String
  payrollItem   PayrollItem   @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  name          String
  type          ComponentType @default(EARNING)
  amount        Decimal       @db.Decimal(12, 2)
  taxable       Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([payrollItemId])
}

model PayrollDeduction {
  id            String        @id @default(cuid())
  tenantId      String
  payrollItemId String
  payrollItem   PayrollItem   @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  name          String
  type          ComponentType @default(DEDUCTION)
  amount        Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())

  @@index([payrollItemId])
}

model PayrollApproval {
  id             String           @id @default(cuid())
  tenantId       String
  payrollRunId   String
  payrollRun     PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  level          Int              @default(1)
  approverId     String?
  approver       User?            @relation(fields: [approverId], references: [id], onDelete: SetNull)
  decision       ApprovalDecision @default(PENDING)
  remarks        String?
  previousStatus String?
  newStatus      String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@unique([payrollRunId, level])
  @@index([tenantId, payrollRunId])
}

model Payslip {
  id              String      @id @default(cuid())
  tenantId        String
  payrollItemId   String      @unique
  payrollItem     PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  payrollRunId    String
  payrollRun      PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  grossSalary     Decimal     @db.Decimal(12, 2)
  totalDeductions Decimal     @db.Decimal(12, 2)
  netSalary       Decimal     @db.Decimal(12, 2)
  paymentStatus   String      @default("UNPAID")
  paymentDate     DateTime?
  pdfUrl          String?
  emailedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, payrollRunId])
}

// ============================================================================
// LOANS & ADVANCES
// ============================================================================

model EmployeeLoan {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanNumber        String
  employeeId        String
  employee          Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanAmount        Decimal    @db.Decimal(12, 2)
  approvedAmount    Decimal    @db.Decimal(12, 2)
  issueDate         DateTime
  installmentCount  Int
  installmentAmount Decimal    @db.Decimal(12, 2)
  remainingBalance  Decimal    @db.Decimal(12, 2)
  startMonth        DateTime
  status            LoanStatus @default(PENDING)
  approvedById      String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  installments LoanInstallment[]

  @@unique([tenantId, loanNumber])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model LoanInstallment {
  id            String       @id @default(cuid())
  tenantId      String
  loanId        String
  loan          EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payrollRunId  String?
  payrollItemId String?
  dueDate       DateTime
  paidDate      DateTime?
  amount        Decimal      @db.Decimal(12, 2)
  status        String       @default("PENDING")
  createdAt     DateTime     @default(now())

  @@index([tenantId, loanId])
  @@index([tenantId, payrollRunId])
}

model SalaryAdvance {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(12, 2)
  remaining         Decimal       @db.Decimal(12, 2)
  issueDate         DateTime
  installments      Int           @default(1)
  installmentAmount Decimal       @db.Decimal(12, 2)
  status            AdvanceStatus @default(PENDING)
  approvedById      String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model Overtime {
  id            String         @id @default(cuid())
  tenantId      String
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime
  hours         Decimal        @db.Decimal(5, 2)
  rate          Decimal        @db.Decimal(5, 2)
  status        OvertimeStatus @default(PENDING)
  approvedById  String?
  payrollItemId String?
  notes         String?
  createdAt     DateTime       @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id        String              @id @default(cuid())
  tenantId  String?
  tenant    Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([tenantId])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey  String // leave.submitted, payroll.generated ...
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  whatsapp  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventKey])
  @@index([userId])
}

// ============================================================================
// PLATFORM ADMIN MODELS
// ============================================================================

model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  module         String
  recordId       String?
  recordType     String?
  ipAddress      String?
  userAgent      String?
  previousValues Json?
  newValues      Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([module, createdAt])
  @@index([userId])
}

model BackgroundJobLog {
  id         String    @id @default(cuid())
  jobName    String
  queueName  String
  jobId      String?
  status     String // QUEUED | RUNNING | COMPLETED | FAILED | SKIPPED
  attempts   Int       @default(0)
  error      String?
  metadata   Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([jobName, createdAt])
  @@index([status])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  scope       String   @default("PLATFORM") // PLATFORM | TENANT
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Currency {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  symbol   String
  decimals Int     @default(2)
  isActive Boolean @default(true)
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  bodyHtml  String
  bodyText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// STUDENT MANAGEMENT
// ============================================================================

model Student {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rollNumber  String
  fullName    String
  fatherName  String
  nationalId  String    // B-Form or CNIC
  className   String    // Nursery, KG, Class 1-12, BS, MS, PhD, etc.
  section     String?   // A, B, C, D (for classes <= 12)
  gender      Gender?
  dateOfBirth DateTime?
  phone       String?
  email       String?
  address     String?
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  monthlyFee  Decimal   @default(0)
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, ALUMNI
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attendances StudentAttendance[]
  fees        StudentFee[]

  @@unique([tenantId, rollNumber])
  @@index([tenantId, className, section])
  @@index([tenantId, nationalId])
  @@index([tenantId, status])
}

model StudentAttendance {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, studentId, date])
  @@index([tenantId, date])
  @@index([tenantId, studentId])
}

model StudentFee {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month         String    // e.g. "2026-10"
  feeAmount     Decimal
  paidAmount    Decimal   @default(0)
  dueAmount     Decimal   @default(0)
  status        String    @default("PENDING") // PENDING, PAID, PARTIAL
  paymentMethod String?   // CASH, BANK, ONLINE, CHEQUE
  paidAt        DateTime?
  receiptNumber String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, studentId, month])
  @@index([tenantId, month, status])
  @@index([tenantId, studentId])
}
